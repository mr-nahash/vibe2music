# Required: paste the key from your Atlas Cloud dashboard.
ATLASCLOUD_API_KEY=

# Defaults: normally leave these unchanged.
ATLAS_MODEL=suno/chirp-fenix
V2M_ENGINE=atlas
JOBS_DIR=jobs

# Optional: enables AI-written prompts/metadata. Local templates work without it.
ANTHROPIC_API_KEY=

# Safety: keep false until you have reviewed several outputs.
V2M_ALLOW_PUBLIC_UPLOAD=false
