# Required by the local API. Generate a long random value.
API_TOKEN=replace-with-a-long-random-secret

# Optional: prompt and metadata generation fall back to deterministic local
# templates when this is absent.
ANTHROPIC_API_KEY=

# Optional model/runtime overrides.
ACE_CHECKPOINT_PATH=
V2M_DEVICE=auto
V2M_DEVICE_ID=0
V2M_BF16=true
V2M_CPU_OFFLOAD=false
V2M_OVERLAPPED_DECODE=false
JOBS_DIR=jobs

# Keep false until you have manually reviewed several uploads.
V2M_ALLOW_PUBLIC_UPLOAD=false
